# Engineering Hub — Configuration
# Copy to .env and fill in your values

# AI Assistant (required)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model to use (default: gemini-2.5-flash)
# Other options: gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro
# GEMINI_MODEL=gemini-2.5-flash

# Jira Integration
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=ENG                          # your Jira project key (e.g. ENG, DL, PROJ)

# Your Jira/Atlassian display name — used to filter stories assigned to you
USER_DISPLAY_NAME=Your Name

# GitHub Integration
# Recommended: run `gh auth login` — no config needed
# Alternative: set a personal access token (scopes: repo, read:user)
# GITHUB_TOKEN=ghp_your_token_here

# GitHub orgs to search for PR reviews (comma-separated). Leave empty to skip review sync.
# GITHUB_ORGS=mycompany,mycompany-internal

# Sync start date for first-time historical sync (default: 2026-01-01)
# SYNC_START_DATE=2026-01-01
